# Never bake the host venv into the build context — it's the wrong Python
# ABI for the image anyway; the Dockerfile builds its own with uv.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Real, unanonymized race data (see CLAUDE.md / tests/fixtures/README) has no
# business inside a deployable image.
tests/

var/
.env
.env.*
.git
