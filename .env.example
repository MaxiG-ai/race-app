# Backend
DATABASE_URL=postgresql+psycopg://race:race@localhost:5432/race
JWT_SECRET=change-me
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]
UPLOAD_DIR=./var/uploads
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# Frontend (build time)
VITE_API_BASE_URL=http://localhost:8000/api

# Deployment (docker-compose.prod.yml + Caddyfile) — see README §Deployment.
# In production, DATABASE_URL above should point at the `db` service host
# (e.g. postgresql+psycopg://race:change-me@db:5432/race), CORS_ORIGINS and
# VITE_API_BASE_URL at https://$DOMAIN, and COOKIE_SECURE=true.
DOMAIN=race.example.com
ACME_EMAIL=you@example.com
POSTGRES_USER=race
POSTGRES_PASSWORD=change-me
POSTGRES_DB=race
COOKIE_DOMAIN=race.example.com

# Backend (gunicorn — optional overrides, defaults shown)
GUNICORN_WORKERS=2
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_TIMEOUT=30

# Backups (scripts/backup.sh — optional overrides, defaults shown)
BACKUP_DIR=/opt/race-app/backups
RETENTION_DAYS=14
