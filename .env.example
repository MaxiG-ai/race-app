# Copy to .env and adjust. Every variable the app reads is listed here.

# private: every page needs the owner's login. public: visitors can read published races.
SITE_MODE=private

# Postgres credentials; docker-compose.yml builds DATABASE_URL from these.
POSTGRES_USER=race
POSTGRES_PASSWORD=change-me
POSTGRES_DB=race
# Only needed when running the app outside docker compose:
# DATABASE_URL=postgresql+psycopg://race:change-me@localhost:5432/race

# Where original FIT files are kept (a mounted volume in Docker).
# UPLOAD_DIR=/data/uploads
# MAX_UPLOAD_BYTES=20971520

# Historical weather API (Open-Meteo archive; free, no key).
# OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# Host port for local/self-hosted runs. Bound to localhost by default.
# APP_PORT=127.0.0.1:8000

# Public mode only (docker-compose.public.yml).
DOMAIN=race.example.com
ACME_EMAIL=you@example.com

# scripts/backup.sh
BACKUP_DIR=/opt/race-app/backups
RETENTION_DAYS=14
