# Public deployments only. Caddy terminates TLS (Let's Encrypt) and proxies everything to
# the app, which serves the pages, /static and /api itself. Caddy serves no files.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Matches the app's own 20 MB upload limit (MAX_UPLOAD_BYTES), with room for
	# several files in one request.
	request_body {
		max_size 100MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:8000
}
